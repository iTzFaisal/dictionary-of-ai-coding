---
import type { Section } from "../lib/dictionary";
const { sections, currentTerm } = Astro.props as { sections: Section[]; currentTerm?: string };
const base = `${import.meta.env.BASE_URL}/`;
const href = (term: string) => `${base}terms/${term.toLowerCase().normalize("NFKD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")}/`;
---
<nav aria-label="Curriculum">
  {sections.map((section) => (
    <section class="curriculum-section">
      <h2>{section.heading}</h2>
      <ul>
        {section.terms.map((term) => <li><a class:list={[{ current: term === currentTerm }]} href={href(term)} aria-current={term === currentTerm ? "page" : undefined}>{term}</a></li>)}
      </ul>
    </section>
  ))}
</nav>
